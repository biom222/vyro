DATABASE_URL=sqlite:///./video_editor.sqlite3
# Legacy web prototype only; desktop publication uses direct platform APIs.
TAISLY_API_KEY=
TAISLY_BASE_URL=https://app.taisly.com/api/private
UPLOAD_FOLDER=./uploads
OUTPUT_FOLDER=./outputs
DATA_FOLDER=./data
CACHE_FOLDER=./cache
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MAX_FILE_SIZE=524288000
MAX_VIDEO_DURATION=600

# Content assistant: mock or openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna

# Speech-to-text: mock or faster-whisper
TRANSCRIPTION_PROVIDER=mock
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Trends and analytics
YOUTUBE_API_KEY=
YOUTUBE_REGION=RU
YOUTUBE_LANGUAGE=ru
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
# Register the matching desktop OAuth redirect URI with each provider.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8766/oauth/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8767/oauth/callback
INSTAGRAM_GRAPH_VERSION=v23.0
TRENDS_MOCK_MODE=true
CREDENTIAL_BACKEND=keyring
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=15
SCHEDULER_BATCH_SIZE=10
